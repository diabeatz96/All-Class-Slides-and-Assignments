# Copy this file to .env (same folder), then paste in YOUR values.
# .env is secret and stays on your laptop. This example file is safe to commit.

# Supabase dashboard: click Connect (top of the page). Looks like https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard: Project Settings, then API Keys, then Secret keys. Starts with sb_secret_
SUPABASE_SECRET_KEY=sb_secret_paste_yours_here

PORT=3000
